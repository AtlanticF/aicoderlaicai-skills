{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/atlanticf/aicoderlaicai-skills/prd-executable-spec/schemas/prd_spec.schema.json",
  "title": "PRD Executable Spec",
  "description": "Machine-validatable schema for prd_spec.json. Use in CI to enforce the Phase 4 gate automatically.",
  "type": "object",
  "required": ["spec_version", "source_document", "requirements"],
  "additionalProperties": false,
  "properties": {
    "spec_version": { "type": "string" },
    "source_document": { "type": "string" },
    "source_hash": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "glossary": {
      "type": "array",
      "items": { "$ref": "#/$defs/glossaryTerm" }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" }
    },
    "assumptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/assumption" }
    },
    "change_log": {
      "type": "array",
      "items": { "$ref": "#/$defs/change" }
    }
  },
  "$defs": {
    "glossaryTerm": {
      "type": "object",
      "required": ["term", "definition", "canonical_name"],
      "additionalProperties": false,
      "properties": {
        "term": { "type": "string" },
        "definition": { "type": "string" },
        "canonical_name": { "type": "string" },
        "aliases": { "type": "array", "items": { "type": "string" } }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "module", "feature", "requirement", "original_text", "29148_category", "spec_status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^M[0-9]+-F[0-9]+-R[0-9]+$" },
        "module": { "type": "string" },
        "feature": { "type": "string" },
        "requirement": { "type": "string" },
        "original_text": { "type": "string" },
        "intent": { "type": "string" },
        "29148_category": {
          "type": "string",
          "enum": ["functional", "interface", "performance", "constraint", "quality"]
        },
        "complexity": { "type": "string", "enum": ["S", "M", "L", "XL"] },
        "risk": { "type": "string", "enum": ["low", "medium", "high"] },
        "acceptance_owner": { "type": "string" },
        "gherkin": { "type": ["string", "null"] },
        "logic": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "pseudocode": { "type": ["string", "null"] },
            "formula": { "type": ["string", "null"] },
            "state_machine": { "type": ["string", "null"] },
            "conditions": { "type": "array", "items": { "type": "string" } }
          }
        },
        "data_schema": { "type": ["object", "null"] },
        "entity_impact": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "new_entities": { "type": "array", "items": { "type": "string" } },
            "modified_entities": { "type": "array", "items": { "type": "string" } },
            "migration_notes": { "type": ["string", "null"] }
          }
        },
        "api_spec": {
          "type": ["object", "null"],
          "properties": {
            "path": { "type": "string" },
            "method": { "type": "string", "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"] },
            "parameters": { "type": "array" },
            "request_body": { "type": ["object", "null"] },
            "responses": { "type": "object" }
          }
        },
        "error_contract": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["code", "when", "retriable"],
                "additionalProperties": false,
                "properties": {
                  "code": { "type": "string" },
                  "http_status": { "type": "integer" },
                  "when": { "type": "string" },
                  "retriable": { "type": "boolean" }
                }
              }
            },
            "idempotent": { "type": "boolean" },
            "idempotency_key": { "type": ["string", "null"] },
            "retry_policy": { "type": ["string", "null"] }
          }
        },
        "observability": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "logs": { "type": "array", "items": { "type": "string" } },
            "metrics": { "type": "array", "items": { "type": "string" } },
            "alerts": { "type": "array", "items": { "type": "string" } }
          }
        },
        "nfr": {
          "type": "array",
          "items": { "$ref": "#/$defs/nfr" }
        },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "issues": {
          "type": "array",
          "items": { "$ref": "#/$defs/issue" }
        },
        "spec_status": {
          "type": "string",
          "enum": ["draft", "needs_clarification", "confirmed"]
        }
      },
      "allOf": [
        {
          "$comment": "Gate: a confirmed point must not carry open blocker/major issues.",
          "if": {
            "properties": {
              "issues": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": { "severity": { "enum": ["blocker", "major"] } },
                  "required": ["severity"]
                }
              }
            },
            "required": ["issues"]
          },
          "then": {
            "properties": { "spec_status": { "const": "needs_clarification" } }
          }
        }
      ]
    },
    "nfr": {
      "type": "object",
      "required": ["category", "metric", "target", "verification_method"],
      "additionalProperties": false,
      "properties": {
        "category": {
          "type": "string",
          "enum": ["performance", "scalability", "availability", "security", "maintainability", "compatibility", "usability", "portability", "reliability"]
        },
        "metric": { "type": "string" },
        "target": { "type": "string" },
        "condition": { "type": "string" },
        "verification_method": {
          "type": "string",
          "enum": ["load_test", "chaos_test", "static_analysis", "pen_test", "manual_review", "monitoring_slo", "benchmark"]
        }
      }
    },
    "issue": {
      "type": "object",
      "required": ["type", "severity", "location", "description"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": ["undefined", "logic_flaw", "contradiction", "ambiguity", "missing_boundary", "missing_edge_case"]
        },
        "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
        "location": {
          "type": "string",
          "enum": ["gherkin", "pseudocode", "formula", "state_machine", "data_schema", "api_spec", "error_contract", "observability", "nfr", "cross_module"]
        },
        "original_text": { "type": "string" },
        "description": { "type": "string" },
        "proposed_fix": { "type": "string" },
        "question": { "type": "string" }
      }
    },
    "assumption": {
      "type": "object",
      "required": ["id", "requirement_id", "statement", "default_choice", "status"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "requirement_id": { "type": "string" },
        "statement": { "type": "string" },
        "default_choice": { "type": "string" },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "rationale": { "type": "string" },
        "needs_veto_by": { "type": "string" },
        "status": { "type": "string", "enum": ["assumed", "vetoed", "ratified"] }
      }
    },
    "change": {
      "type": "object",
      "required": ["requirement_id", "change_type", "summary"],
      "additionalProperties": false,
      "properties": {
        "requirement_id": { "type": "string" },
        "change_type": { "type": "string", "enum": ["added", "modified", "removed"] },
        "summary": { "type": "string" },
        "stale_artifacts": { "type": "array", "items": { "type": "string" } },
        "impacted_downstream": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
